# MusicFlow deployment environment
# Copy to .env and fill in values:  cp .env.example .env

# Required: JWT signing key (>=32 chars) - generate with: openssl rand -hex 32
JWT_SECRET=

# Optional: comma-separated allowed CORS origins (the web UI is same-origin,
# so this only matters for direct cross-origin API clients). * = allow all.
CORS_ORIGINS=*

# Optional: play history retention in days (default 180)
PLAY_HISTORY_RETENTION_DAYS=180
