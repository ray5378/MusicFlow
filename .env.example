# MusicFlow deployment environment
# Copy to .env and adjust if needed:  cp .env.example .env

# Optional: JWT signing key (>=32 chars). Leave empty to auto-generate one on
# first start (persisted in ./data/.jwt-secret, stable across restarts).
# Generate your own with: openssl rand -hex 32
JWT_SECRET=

# Optional: comma-separated allowed CORS origins (the web UI is same-origin,
# so this only matters for direct cross-origin API clients). * = allow all.
CORS_ORIGINS=*

# Optional: play history retention in days (default 3)
PLAY_HISTORY_RETENTION_DAYS=3
