# 复制为 .env 并填入随机值(生成: openssl rand -hex 32)
# 用于 JWT 签名与 pass_enc 密码加密,长度必须 >= 32 字符,否则服务拒绝启动
JWT_SECRET=

# 允许跨域直连的 Origin 白名单(逗号分隔),设为 * 则允许全部
CORS_ORIGINS=http://localhost:46399,http://127.0.0.1:46399

# 播放历史保留天数
PLAY_HISTORY_RETENTION_DAYS=180

# 内存相关(可选)
# V8 堆上限(服务 JS 堆日常仅 ~30MB,256MB 足够;让 V8 及时压堆减少 RSS 常驻)
# NODE_OPTIONS=--max-old-space-size=256
# 封面解码字节缓存预算(MB,默认 64;SSD 部署可调小,机械盘别低于 64)
# COVER_CACHE_BUDGET_MB=64
# 封面缓存无请求多少分钟后清空(默认 5)
# COVER_CACHE_IDLE_MINUTES=5
