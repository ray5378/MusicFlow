{
  "name": "musicflow-backend",
  "version": "0.0.0-dev",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "NODE_OPTIONS=--max-old-space-size=256 node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/node-server": "^1.11.0",
    "better-sqlite3": "^11.0.0",
    "bonjour-service": "^1.2.1",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "ffmpeg-static": "^5.3.0",
    "hono": "^4.4.0",
    "jsonwebtoken": "^9.0.2",
    "md5": "^2.3.0",
    "music-metadata": "^11.14.0",
    "quickjs-emscripten": "^0.32.0",
    "sharp": "^0.35.4",
    "undici": "^8.10.0",
    "uuid": "^11.1.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/md5": "^2.3.5",
    "@types/node": "^20.14.0",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.12",
    "@vitest/coverage-v8": "^3.2.7",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
